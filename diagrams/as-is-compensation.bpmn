<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.1">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Customer" name="Клиент" />
    <bpmn:participant id="Participant_Company" name="Ручная компенсация по обращению клиента (as-is)" processRef="Process_Compensation" />
    <bpmn:messageFlow id="MF_01" sourceRef="Participant_Customer" targetRef="Start" />
    <bpmn:messageFlow id="MF_02" sourceRef="NotifyOK" targetRef="Participant_Customer" />
    <bpmn:messageFlow id="MF_03" sourceRef="NotifyRefuse" targetRef="Participant_Customer" />
    <bpmn:textAnnotation id="Ann_Fraud">
      <bpmn:text>Проверить долю компенсаций от успешных заказов</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Fraud" associationDirection="None" sourceRef="Fraud" targetRef="Ann_Fraud" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Compensation" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_L1" name="Поддержка L1">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Justified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Amount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_CompMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Accrue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NotifyOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_OK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_RefMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NotifyRefuse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Refuse</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AF" name="Антифрод">
        <bpmn:flowNodeRef>Fraud</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Fraud</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Restrict</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Получено обращение на компенсацию">
      <bpmn:incoming>MF_01</bpmn:incoming>
      <bpmn:outgoing>F_01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_Start" />
    </bpmn:startEvent>
    <bpmn:task id="Identify" name="Выявить суть проблемы">
      <bpmn:incoming>F_01</bpmn:incoming>
      <bpmn:outgoing>F_02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Check" name="Проверить заказ, условия и сумму компенсации">
      <bpmn:incoming>F_02</bpmn:incoming>
      <bpmn:outgoing>F_03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Justified" name="Обращение обосновано?">
      <bpmn:incoming>F_03</bpmn:incoming>
      <bpmn:outgoing>F_04</bpmn:outgoing>
      <bpmn:outgoing>F_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_Amount" name="Сумма компенсации &#62; 1500 рублей?">
      <bpmn:incoming>F_04</bpmn:incoming>
      <bpmn:outgoing>F_06</bpmn:outgoing>
      <bpmn:outgoing>F_07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_CompMerge">
      <bpmn:incoming>F_06</bpmn:incoming>
      <bpmn:incoming>F_09</bpmn:incoming>
      <bpmn:outgoing>F_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Accrue" name="Начислить компенсацию">
      <bpmn:incoming>F_12</bpmn:incoming>
      <bpmn:outgoing>F_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="NotifyOK" name="Сообщить клиенту о компенсации">
      <bpmn:incoming>F_13</bpmn:incoming>
      <bpmn:outgoing>F_14</bpmn:outgoing>
      <bpmn:outgoing>MF_02</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_OK" name="Компенсация начислена">
      <bpmn:incoming>F_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GW_RefMerge">
      <bpmn:incoming>F_05</bpmn:incoming>
      <bpmn:incoming>F_11</bpmn:incoming>
      <bpmn:outgoing>F_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="NotifyRefuse" name="Сообщить клиенту об отказе в компенсации">
      <bpmn:incoming>F_15</bpmn:incoming>
      <bpmn:outgoing>F_16</bpmn:outgoing>
      <bpmn:outgoing>MF_03</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_Refuse" name="В компенсации отказано">
      <bpmn:incoming>F_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Fraud" name="Проверить пользователя на признаки фрода">
      <bpmn:incoming>F_07</bpmn:incoming>
      <bpmn:outgoing>F_08</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Fraud" name="Есть признаки фрода?">
      <bpmn:incoming>F_08</bpmn:incoming>
      <bpmn:outgoing>F_09</bpmn:outgoing>
      <bpmn:outgoing>F_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Restrict" name="Ограничить доступ пользователю">
      <bpmn:incoming>F_10</bpmn:incoming>
      <bpmn:outgoing>F_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="F_01" sourceRef="Start" targetRef="Identify" />
    <bpmn:sequenceFlow id="F_02" sourceRef="Identify" targetRef="Check" />
    <bpmn:sequenceFlow id="F_03" sourceRef="Check" targetRef="GW_Justified" />
    <bpmn:sequenceFlow id="F_04" name="Да" sourceRef="GW_Justified" targetRef="GW_Amount" />
    <bpmn:sequenceFlow id="F_05" name="Нет" sourceRef="GW_Justified" targetRef="GW_RefMerge" />
    <bpmn:sequenceFlow id="F_06" name="Нет" sourceRef="GW_Amount" targetRef="GW_CompMerge" />
    <bpmn:sequenceFlow id="F_07" name="Да" sourceRef="GW_Amount" targetRef="Fraud" />
    <bpmn:sequenceFlow id="F_08" sourceRef="Fraud" targetRef="GW_Fraud" />
    <bpmn:sequenceFlow id="F_09" name="Нет" sourceRef="GW_Fraud" targetRef="GW_CompMerge" />
    <bpmn:sequenceFlow id="F_10" name="Да" sourceRef="GW_Fraud" targetRef="Restrict" />
    <bpmn:sequenceFlow id="F_11" sourceRef="Restrict" targetRef="GW_RefMerge" />
    <bpmn:sequenceFlow id="F_12" sourceRef="GW_CompMerge" targetRef="Accrue" />
    <bpmn:sequenceFlow id="F_13" sourceRef="Accrue" targetRef="NotifyOK" />
    <bpmn:sequenceFlow id="F_14" sourceRef="NotifyOK" targetRef="End_OK" />
    <bpmn:sequenceFlow id="F_15" sourceRef="GW_RefMerge" targetRef="NotifyRefuse" />
    <bpmn:sequenceFlow id="F_16" sourceRef="NotifyRefuse" targetRef="End_Refuse" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_Customer_di" bpmnElement="Participant_Customer" isHorizontal="true">
        <dc:Bounds x="160" y="60" width="1620" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Company_di" bpmnElement="Participant_Company" isHorizontal="true">
